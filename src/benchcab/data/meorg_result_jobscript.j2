#!/bin/bash
#PBS -l wd
#PBS -l ncpus={{num_threads}}
#PBS -l mem={{mem}}
#PBS -l walltime={{walltime}}
#PBS -q copyq
#PBS -P {{project}}
#PBS -j oe
#PBS -m e
#PBS -l storage={{storage_str}}

set -ev

MEORG_BIN={{meorg_bin}}
MODEL_OUTPUT_ID=$(cat {{run_dir}}/model_output_id)

# Submit the result first, so that it does not wait for the upload
RESULT_STATUS=0
$MEORG_BIN analysis submit-result $MODEL_OUTPUT_ID {{experiment_id}} {{run_dir}} --orchestrator benchcab || RESULT_STATUS=$?

# Upload the model output files with their original names. me.org matches them
# to the files recorded with the result by name and size.
echo "Uploading data to $MODEL_OUTPUT_ID"
$MEORG_BIN file upload {{data_dir}}/*.nc -n {{num_threads}} $MODEL_OUTPUT_ID

exit $RESULT_STATUS
